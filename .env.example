# Copy to .env.local and fill in.
# Without GCP_PROJECT_ID the app still runs: brand check uses rules only, waitlist logs to console.
# No API keys needed. Auth is Google Application Default Credentials:
#   gcloud auth application-default login

GCP_PROJECT_ID=
VERTEX_REGION=global
CLAUDE_MODEL=claude-sonnet-5

# Proxies after Google's front end, for reading the visitor IP (rate limiting). Verify after first deploy.
TRUSTED_PROXY_HOPS=0

# Firebase web app config (public by design). From Firebase console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Instagram (Phase 2). Secrets live in Secret Manager in production.
APP_URL=http://localhost:3000
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=not-set
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
IG_API_VERSION=v25.0
